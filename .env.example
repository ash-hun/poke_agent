# ── Core ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-api-key-here
MGBA_HTTP_BASE_URL=http://127.0.0.1:5123
AI_MODEL=claude-opus-4-7
MAX_TOKENS=8192

# ── Supervisor Timing ─────────────────────────────────────────────────────────
DIRECTIONAL_HOLD_FRAMES=12   # frames per 1-tile directional move
BUTTON_TAP_FRAMES=6          # frames for A/B/Start/Select tap
POST_ACTION_SETTLE_FRAMES=48 # frames to wait after each action
BLACK_FRAME_MAX_POLLS=5      # how many black-frame checks before giving up

# ── Context ───────────────────────────────────────────────────────────────────
MIN_TURNS_TO_KEEP=8          # turns to keep in Claude's conversation history
